       "                classes = [&quot;col-sm-6&quot;, &quot;col-sm-12&quot;];\n",
       "            } else if (diagramLength === 2) {\n",
       "                classes = [&quot;col-sm-4&quot;, &quot;col-sm-6&quot;];\n",
